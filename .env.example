# Domain panel Pterodactyl, tanpa slash di belakang.
PTERO_URL=https://panel.example.com

# Application API key (PTLA). JANGAN gunakan NEXT_PUBLIC_ karena key harus server-side.
PTERO_API_KEY=ptla_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password untuk masuk ke dashboard monitor.
ADMIN_PASSWORD=ganti-password-dashboard

# Secret acak panjang untuk menandatangani cookie sesi.
SESSION_SECRET=ganti-dengan-random-string-minimal-32-karakter
